# Copy to `.env` (git-ignored) and fill in. Never commit a filled-in .env.
#
# The plugin itself never reads this file: inside Magpie, credentials are typed
# into the sign-in prompts and kept in Magpie's plugin-auth.json. These values
# are only for `npm run live`, the read-only script that checks a real site.

# The New API site, without /v1 or a trailing slash.
NEWAPI_BASE=https://newapi.example.com

# The site's dashboard access token (not an sk-... relay key).
NEWAPI_TOKEN=

# Only for older New API builds and some forks; leave empty otherwise.
NEWAPI_UID=

# Where the script keeps its own key cache. Git-ignored.
NEWAPI_DIR=./.live

# Set to 1 to actually press the daily check-in; anything else only reads it.
NEWAPI_PRESS_CHECKIN=
